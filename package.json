{
  "name": "throw",
  "version": "0.1.0",
  "description": "Live visuals, projection mapping and light sync for small venues. Runs in a browser, offline.",
  "type": "module",
  "license": "MIT",
  "author": "Ilie Beleniuc",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/iliev-blnk/throw.git"
  },
  "homepage": "https://github.com/iliev-blnk/throw#readme",
  "packageManager": "pnpm@11.3.0",
  "engines": {
    "node": ">=20"
  },
  "bin": {
    "throw": "dist-server/cli.js"
  },
  "files": [
    "dist",
    "dist-server"
  ],
  "scripts": {
    "dev": "vite",
    "build": "vite build && tsc -p tsconfig.server.json",
    "start": "pnpm build && node dist-server/cli.js --open",
    "test": "vitest run",
    "test:e2e": "vitest run -c vitest.e2e.config.ts",
    "lint": "biome check .",
    "typecheck": "tsc --noEmit && tsc -p tsconfig.server.json --noEmit",
    "check": "biome check . && tsc --noEmit && vitest run"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.15",
    "@types/node": "^26.6.5",
    "@types/ws": "^8.18.2",
    "playwright-core": "^1.64.0",
    "typescript": "^7.0.2",
    "vite": "^8.3.4",
    "vitest": "^5.0.3"
  },
  "dependencies": {
    "pagepad": "^0.1.0",
    "ws": "^8.22.0"
  }
}
